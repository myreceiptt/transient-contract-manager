{
  "name": "transient-contract-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:integration": "node --import tsx scripts/integration.ts",
    "audit:protocol": "node --import tsx scripts/audit-protocol.ts",
    "audit:supply": "node --import tsx scripts/audit-supply.ts",
    "contracts:verify": "node scripts/compile-contracts.mjs",
    "db:verify": "node --import tsx scripts/verify-migration.ts",
    "test:http": "node --import tsx scripts/http-smoke.ts",
    "test:preview": "node --import tsx scripts/preview-security-smoke.ts",
    "format": "prettier --write src scripts tests README.md docs/*.md .github/workflows/*.yml *.json"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.3.16",
    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "0.577.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "viem": "2.57.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@foundry-rs/anvil": "1.7.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.6.2",
    "solc": "0.8.30",
    "solc-stacks": "npm:solc@0.8.22",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "overrides": {
    "tmp": "0.2.7"
  },
  "engines": {
    "node": ">=22.0.0 <25"
  }
}
