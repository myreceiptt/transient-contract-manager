# Local development only. Hosted origins must be exact HTTPS origins, no trailing slash.
# On the protected Vercel Preview, omit APP_ORIGIN to use trusted VERCEL_URL.
# Never derive the SIWE origin from a request Host/X-Forwarded-Host header.
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
# Local PostgreSQL-compatible PGlite runs only in development.
# Hosted runtime requires Supabase; the preview is locked to ztiegrqflrpoksuocrze.
# Migration 20261021111911 is already applied. Do not reapply it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: leave empty for the first injected-wallet Preview; see docs/PREVIEW_PLAN.md.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
BASE_RPC_URL=https://mainnet.base.org
SHAPE_RPC_URL=https://mainnet.shape.network
# Keep false. This preview release also hard-denies chains 1, 4663, 8453 and 360.
# Enabling this flag alone cannot enable supported-network writes.
MAINNET_WRITES_ENABLED=false
# Local chain is ignored entirely in production.
LOCAL_CHAIN_ENABLED=false
NEXT_PUBLIC_LOCAL_CHAIN_ENABLED=false
LOCAL_RPC_URL=http://127.0.0.1:8545
LOCAL_STACKS_ADDRESS=
LOCAL_CREATOR_ADDRESS=
# Comma-separated operator-approved media hosts; redirects are refused.
# Built-in: ipfs.io, gateway.pinata.cloud, cloudflare-ipfs.com (IPFS paths only).
MEDIA_ALLOWED_HOSTS=
